# Add the real value in Vercel → Project Settings → Environment Variables.
# Never commit a real API key.
OPENAI_API_KEY=

# Optional. NutriPath uses this current vision-capable model by default.
OPENAI_MODEL=gpt-4o

# Required for verified ingredient calculations after a user confirms grams.
USDA_API_KEY=

# Supabase Connect dialog → Project URL and Publishable key.
# The publishable key is designed for browser use; RLS protects user data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# NutriPath does not require a Supabase service-role key.
# Never add a service-role key to a NEXT_PUBLIC_ variable.

# PostHog Analytics (optional — app works without these)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
